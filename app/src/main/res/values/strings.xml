<resources>
    <!-- Spanish is the default language, like the web app (src/locales/es.json). English is
         in values-en/strings.xml; Android picks it when the phone is set to English. -->

    <!-- The app's name, the same in every language -->
    <string name="app_name" translatable="false">Travel Planner</string>

    <!-- Shared by the login and register forms -->
    <string name="email_label">Email</string>
    <string name="email_placeholder">Escribe tu email</string>
    <string name="password_label">Contraseña</string>
    <string name="password_placeholder">Escribe tu contraseña</string>
    <string name="password_min_length">Al menos %1$d caracteres</string>

    <!-- Login -->
    <string name="login_title">Iniciar sesión</string>
    <string name="login_submit">Entrar</string>
    <string name="login_loading">Iniciando sesión</string>
    <string name="login_error">Lo sentimos, el usuario o la contraseña no son correctos.</string>
    <string name="login_network_error">No hemos podido conectar. Comprueba tu conexión a internet e inténtalo de nuevo.</string>
    <string name="login_go_to_register">Crear una cuenta nueva</string>

    <!-- Register -->
    <string name="register_title">Registro</string>
    <string name="register_submit">Crear una cuenta nueva</string>
    <string name="register_loading">Registrando</string>
    <string name="register_successful">Revisa tu email para confirmar el registro.</string>
    <string name="register_go_to_login">¿Ya tienes una cuenta? Inicia sesión</string>
    <string name="register_error">Lo sentimos, ha habido un error. Inténtalo más tarde.</string>

    <!-- Home -->
    <string name="home_title">Inicio</string>
    <string name="hello">Hola</string>
    <string name="logout_submit">Cerrar sesión</string>
    <string name="logout_loading">Cerrando sesión…</string>
    <string name="logout_error">Algo ha fallado al cerrar sesión. Inténtalo de nuevo.</string>
</resources>
